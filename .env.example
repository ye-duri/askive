# Node 24+; copy to .env on the SERVER ONLY. Never put keys under dist/.
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
SENS_SERVICE_ID=
# Registered sender, digits only
SENS_FROM=
# At least 12 characters; enter once on the event iPad
KIOSK_PASSWORD=
MMS_HOURLY_LIMIT=100
HOST=127.0.0.1
PORT=4173
# Required behind HTTPS reverse proxy, without trailing slash
# PUBLIC_ORIGIN=https://your-domain.example
# Actual event organizer and privacy contact must be set before sending.
PRIVACY_OPERATOR=연세중앙교회
PRIVACY_CONTACT=
# Confirm actual SENS message-history retention for your contract/settings.
MMS_HISTORY_RETENTION=

# Legacy server MMS is off. Current UI uses the iPad Messages share sheet.
ENABLE_SENS_MMS=false
